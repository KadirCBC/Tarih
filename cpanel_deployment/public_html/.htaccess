<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ----------------------------------------------------------------------
    # 1. GİZLİ VE KRİTİK DOSYALARI KORUMA (.env, .git, artisan, vb.)
    # ----------------------------------------------------------------------
    # Nokta ile başlayan tüm gizli dosya ve dizinleri engelle (.env, .git, .user.ini vb.)
    RewriteRule (^\.|/\.) - [F,L]

    # Kritik kök dizin dosyalarına erişimi doğrudan yasakla
    RewriteRule ^(artisan|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|README\.md|\.editorconfig) - [F,L,NC]

    # Yetkilendirme Başlığı (Authorization Header)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ----------------------------------------------------------------------
    # 1.1 DOĞRUDAN RESİM HOTLINK KORUMASI (Görsel ve Bant Genişliği Hırsızlığına Karşı)
    # ----------------------------------------------------------------------
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?127\.0\.0\.1 [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?tarih\.numis [NC]
    RewriteCond %{HTTP_REFERER} !^https?://.*google\. [NC]
    RewriteCond %{HTTP_REFERER} !^https?://.*bing\. [NC]
    RewriteCond %{HTTP_REFERER} !^https?://.*yandex\. [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F,NC,L]

    # Sondaki eğik çizgiyi kaldır (Trailing Slash)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Ön Yüz Denetleyicisi (Front Controller) - Var olan dosya veya dizin değilse index.php'ye yönlendir
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ----------------------------------------------------------------------
# 2. APACHE 2.4 DÜZEYİNDE DOSYA ERİŞİM ENGELİ (Ek Güvenlik Katmanı)
# ----------------------------------------------------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(artisan|composer\.(json|lock)|package\.(json|lock)|\.env.*|\.user\.ini|php\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# 3. GÜVENLİK BAŞLIKLARI (SECURITY HEADERS)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Clickjacking saldırılarına karşı koruma
    Header set X-Frame-Options "SAMEORIGIN"

    # MIME-type sniffing saldırılarına karşı koruma
    Header set X-Content-Type-Options "nosniff"

    # XSS Filtresi (Eski tarayıcılar için)
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Gizliliği
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Hassas tarayıcı özelliklerini sınırla
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Server imzasını gizle (mod_headers destekliyorsa)
    Header unset X-Powered-By

    # ----------------------------------------------------------------------
    # CLOUDFLARE CDN EDGE CACHE & IMMUTABLE WEBP YAPILANDIRMASI
    # On binlerce sikke görselinin doğrudan Cloudflare Edge düğümlerinden
    # sunulması ve sunucu CPU/RAM yükünün sıfırlanması için 1 yıl (31536000s)
    # ----------------------------------------------------------------------
    <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Cloudflare-CDN-Cache-Control "max-age=31536000"
        Header set CDN-Cache-Control "max-age=31536000"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 4. STATİK DOSYALAR İÇİN ÖNBELLEKLEME (Sikke Fotoğrafları & Varlıklar)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Sikke Fotoğrafları ve Grafikler (WebP Öncelikli)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fontlar
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# 5. BROTLI & GZIP / DEFLATE SIKIŞTIRMA (cPanel & Plesk Hız Optimizasyonu)
# ----------------------------------------------------------------------
# Brotli (Mevcutsa Öncelikli Yüksek Sıkıştırma)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/plain
    AddOutputFilterByType BROTLI_COMPRESS text/html
    AddOutputFilterByType BROTLI_COMPRESS text/xml
    AddOutputFilterByType BROTLI_COMPRESS text/css
    AddOutputFilterByType BROTLI_COMPRESS application/xml
    AddOutputFilterByType BROTLI_COMPRESS application/xhtml+xml
    AddOutputFilterByType BROTLI_COMPRESS application/rss+xml
    AddOutputFilterByType BROTLI_COMPRESS application/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# Gzip / Deflate (Geriye Dönük Uyumluluk)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

