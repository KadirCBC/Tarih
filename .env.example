APP_NAME="Antik Numismatik Ansiklopedisi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
APP_URL=https://example.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=numismatic_catalog
DB_USERNAME=cpanel_user
DB_PASSWORD=secret_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=file

FILESYSTEM_DISK=public

# AI Sikke Tanıma Servisleri
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VECTOR_SERVICE_URL=http://127.0.0.1:8000

# Spatie Backup & S3 / Wasabi / MinIO / FTP Yapılandırması
BACKUP_DESTINATION_DISK=backup_remote
BACKUP_DISK_DRIVER=s3
BACKUP_AWS_KEY=your-access-key-id
BACKUP_AWS_SECRET=your-secret-access-key
BACKUP_AWS_REGION=eu-central-1
BACKUP_AWS_BUCKET=numismatic-backups
BACKUP_AWS_ENDPOINT=https://s3.wasabisys.com
BACKUP_USE_PATH_STYLE=true
BACKUP_NOTIFICATION_EMAIL=admin@example.com
BACKUP_ARCHIVE_PASSWORD=secure-zip-password

# Alternatif Uzak FTP Yedekleme
BACKUP_FTP_HOST=backup.example.com
BACKUP_FTP_USERNAME=ftp_backup_user
BACKUP_FTP_PASSWORD=ftp_backup_secret
BACKUP_FTP_PORT=21
BACKUP_FTP_ROOT=/backups
